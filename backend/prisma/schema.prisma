generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Игроки и клубы — РЕАЛЬНЫЕ футболисты/клубы/лиги (имя, позиция, нация,
// клуб текстом, числовые характеристики). Никаких фото/логотипов — только
// абстрактная процедурная графика на фронтенде (PlayerPortrait/ClubCrest).
// Рейтинг и суб-статы — собственная формула, не копия EA.
// ──────────────────────────────────────────

model League {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  clubs Club[]

  @@map("leagues")
}

model Club {
  id             String @id @default(cuid())
  name           String
  shortName      String
  colorPrimary   String
  colorSecondary String

  league   League @relation(fields: [leagueId], references: [id])
  leagueId String

  players Player[]
  stadium Stadium?

  @@unique([leagueId, name])
  @@map("clubs")
}

enum Position {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LW
  RW
  ST
  CF
}

enum Rarity {
  BRONZE
  SILVER
  GOLD
  LEGEND
  ICON
}

enum Foot {
  LEFT
  RIGHT
}

model Player {
  id         String @id @default(cuid())
  name       String
  fullName   String
  nation     String
  nationFlag String

  position  Position
  overall   Int
  pace      Int
  shooting  Int
  passing   Int
  dribbling Int
  defending Int
  physical  Int

  age        Int
  height     Int
  foot       Foot
  weakFoot   Int  @default(3)
  skillMoves Int  @default(3)

  rarity Rarity

  // Жёсткий лимит копий для ультра-редких игроков (null = без лимита). Лимит
  // считается по количеству ЖИВЫХ карт (Card) этого игрока — не отдельный
  // счётчик: если все копии распроданы/сожжены, слот освобождается сам.
  maxSupply Int?

  club   Club   @relation(fields: [clubId], references: [id])
  clubId String

  cards Card[]

  createdAt DateTime @default(now())

  @@index([rarity])
  @@index([clubId])
  @@map("players")
}

// ──────────────────────────────────────────
// Стадионы — реальные арены клубов топ-5 лиг. Редкость — функция от
// вместимости (пороги в backend/src/lib/stadiums.ts). Только факты
// (название/город/вместимость/год) — без фото, без детальной архитектуры.
// ──────────────────────────────────────────

model Stadium {
  id         String @id @default(cuid())
  name       String
  city       String
  capacity   Int
  openedYear Int
  rarity     Rarity

  club   Club   @relation(fields: [clubId], references: [id])
  clubId String @unique

  stadiumCards StadiumCard[]

  @@index([rarity])
  @@map("stadiums")
}

model StadiumCard {
  id        String  @id @default(cuid())
  stadium   Stadium @relation(fields: [stadiumId], references: [id])
  stadiumId String
  owner     User    @relation(fields: [ownerId], references: [id])
  ownerId   String

  isListed       Boolean @default(false)
  quickSellPrice Int

  obtainedAt DateTime @default(now())

  listing Listing?

  @@index([ownerId])
  @@index([stadiumId])
  @@map("stadium_cards")
}

// ──────────────────────────────────────────
// Пользователь и его карточки
// ──────────────────────────────────────────

model User {
  id         String  @id @default(cuid())
  tgId       String  @unique
  username   String?
  firstName  String?
  photoUrl   String?
  avatarIcon String?

  coins Int @default(5000)

  dailyStreak      Int       @default(0)
  lastDailyClaimAt DateTime?

  // Спин игроков и спин стадионов — раздельные бесплатные попытки раз в 4 часа
  lastFreeSpinAt        DateTime?
  lastFreeStadiumSpinAt DateTime?

  // Азарт (Hot Streak): растёт, пока игрок не пропускает "окно" между спинами
  // и/или крутит с жёстким фильтром (клуб) — временно поднимает шанс апгрейда
  // результата до LEGEND/ICON. Сбрасывается, если спин пропущен надолго.
  hotStreakCount Int @default(0)

  // Пассивные "дивиденды" за владение лимитированными (maxSupply) картами —
  // копится лениво по времени, см. lib/relics.ts.
  relicDividendsCollectedAt DateTime?

  cards        Card[]
  stadiumCards StadiumCard[]
  listings     Listing[]
  marketBids   MarketBid[]
  transactions Transaction[]

  createdAt DateTime @default(now())

  @@map("users")
}

model Card {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id])
  playerId String
  owner    User   @relation(fields: [ownerId], references: [id])
  ownerId  String

  rarity         Rarity
  isListed       Boolean @default(false)
  quickSellPrice Int

  obtainedAt DateTime @default(now())

  listing Listing?

  @@index([ownerId])
  @@index([playerId])
  @@map("cards")
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
}

// Лот рынка — ровно одно из cardId/stadiumCardId заполнено (проверяется в коде роута).
model Listing {
  id String @id @default(cuid())

  card   Card?   @relation(fields: [cardId], references: [id])
  cardId String? @unique

  stadiumCard   StadiumCard? @relation(fields: [stadiumCardId], references: [id])
  stadiumCardId String?      @unique

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  price       Int
  buyNowPrice Int?
  status      ListingStatus @default(ACTIVE)

  bids MarketBid[]

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([status])
  @@map("listings")
}

model MarketBid {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  bidder    User    @relation(fields: [bidderId], references: [id])
  bidderId  String

  amount Int

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("market_bids")
}

// ──────────────────────────────────────────
// Экономика
// ──────────────────────────────────────────

enum TransactionType {
  SPIN_PLAYER
  SPIN_STADIUM
  STADIUM_CASE_OPEN
  QUICK_SELL
  MARKET_BUY
  MARKET_SELL
  MARKET_FEE
  DAILY_BONUS
}

model Transaction {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  type   TransactionType
  amount Int
  meta   Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("transactions")
}
