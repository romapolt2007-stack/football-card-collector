generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Игроки и состав лиги (вымышленная вселенная —
// см. README-FICTION.md: никаких реальных имён/клубов/лого)
// ──────────────────────────────────────────

model League {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  clubs Club[]

  @@map("leagues")
}

model Club {
  id       String @id @default(cuid())
  name     String
  shortName String
  colorPrimary   String
  colorSecondary String

  league   League @relation(fields: [leagueId], references: [id])
  leagueId String

  players Player[]

  @@unique([leagueId, name])
  @@map("clubs")
}

enum Position {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LW
  RW
  ST
  CF
}

enum Rarity {
  BRONZE
  SILVER
  GOLD
  LEGEND
  ICON
}

enum Foot {
  LEFT
  RIGHT
}

model Player {
  id       String @id @default(cuid())
  name     String
  fullName String
  photoUrl String?
  nation   String
  nationFlag String

  position Position
  overall  Int
  pace       Int
  shooting   Int
  passing    Int
  dribbling  Int
  defending  Int
  physical   Int

  age        Int
  height     Int
  foot       Foot
  weakFoot   Int @default(3)
  skillMoves Int @default(3)

  rarity Rarity

  club   Club   @relation(fields: [clubId], references: [id])
  clubId String

  cards Card[]

  createdAt DateTime @default(now())

  @@index([rarity])
  @@index([clubId])
  @@map("players")
}

// ──────────────────────────────────────────
// Пользователь и его карточки
// ──────────────────────────────────────────

model User {
  id         String  @id @default(cuid())
  tgId       String  @unique
  username   String?
  firstName  String?
  photoUrl   String?

  coins Int @default(5000)
  stars Int @default(0)
  xp    Int @default(0)
  level Int @default(1)

  teamName   String?
  teamLogo   String?
  teamColors String?
  avatarIcon String?

  isVip    Boolean   @default(false)
  vipUntil DateTime?

  referralCode String  @unique @default(cuid())
  referredBy   String?

  hasClaimedStarter Boolean   @default(false)
  dailyStreak       Int       @default(0)
  lastDailyClaimAt  DateTime?
  // Куплена ли "страховка" пропущенного дня — сохраняет стрик при следующем клейме вместо сброса на 1
  streakInsuredAt   DateTime?

  // Короткий таймер-бонус для удержания (каждые N минут) + отметка,
  // чтобы не слать уведомление повторно, пока бонус лежит неполученным
  lastFreeBonusAt     DateTime?
  freeBonusNotifiedAt DateTime?

  // "Спасательный" бонус — доступен чаще, но только когда монет почти нет
  lastEmergencyBonusAt DateTime?

  // Платная рулетка «Удача»: счётчик спинов для pity-системы (каждый 100-й — гарантированный буст)
  luckySpinCount Int @default(0)

  // Один бесплатный спин «Удачи» раз в сутки — чтобы можно было пробовать удачу не только за монеты
  lastFreeLuckySpinAt DateTime?

  // Аркадный режим «Пенальти» — одна бесплатная серия в сутки, дальше за монеты
  lastFreeArcadePenaltyAt DateTime?

  // Кубок на выбывание — одна бесплатная попытка в сутки (см. lib/cup.ts)
  lastFreeCupAt DateTime?

  // Глобальный турнир (64 участника: вы + честные процедурные боты) — редкая раз-в-неделю попытка
  lastFreeTournamentAt DateTime?

  // World Tour — сюжетный режим: сколько этапов (городов) уже пройдено (см. lib/worldTour.ts)
  worldTourStage Int @default(0)

  // Battle Pass (один бессрочный сезон в v1, без реальной ротации) — см. lib/battlePass.ts
  battlePassXp      Int     @default(0)
  battlePassPremium Boolean @default(false)

  battlePassClaims BattlePassClaim[]

  // Косметическая тема интерфейса из «Патчей сообщества» — только акцентный цвет, без игровой логики
  cosmeticPatchId String?

  // Энергия — ограничивает платные/PvP-режимы (Дуэль), восстанавливается лениво по времени
  energy          Int      @default(20)
  energyUpdatedAt DateTime @default(now())

  // Карьерная статистика пенальти (во всех 3 режимах: послематчевая серия, аркада, Дуэль) — для тиерных ачивок
  penaltyGoals Int @default(0)
  penaltySaves Int @default(0)

  // Flash-челлендж: номер 3-дневного цикла, за который уже забрана награда (см. lib/flashChallenge.ts)
  flashChallengeClaimedCycle Int?

  // Трофейная комната / стадион: пассивный доход, копится лениво по времени (см. lib/stadium.ts)
  stadiumLevel         Int      @default(1)
  stadiumCollectedAt   DateTime @default(now())

  duelTrophy DuelTrophy?
  careerTrophy CareerTrophy?
  clanMember   ClanMember?

  cards       Card[]
  listings    Listing[]
  marketBids  MarketBid[]
  matches     Match[]
  transactions Transaction[]
  userQuests  UserQuest[]
  squads      Squad[]
  sbcCompletions SbcCompletion[]
  duelMatchesAsAttacker DuelMatch[] @relation("DuelAttacker")

  createdAt DateTime @default(now())

  @@map("users")
}

model Card {
  id         String @id @default(cuid())
  player     Player @relation(fields: [playerId], references: [id])
  playerId   String
  owner      User   @relation(fields: [ownerId], references: [id])
  ownerId    String

  rarity         Rarity
  isListed       Boolean @default(false)
  quickSellPrice Int

  // Коллекционное издание (ruby/filigree-gold/sapphire/emerald/amethyst/obsidian) — редкий
  // косметический дроп из паков, см. backend/src/lib/specialEditions.ts. null = обычная карта.
  specialEdition String?

  obtainedAt DateTime @default(now())

  // Дисквалификация (красная карточка) или травма — сколько ближайших матчей
  // команды игрок пропускает. Уменьшается на 1 после каждого сыгранного матча.
  unavailableMatches Int @default(0)

  // Тренировка: сжигание дубля той же карты даёт +1 к OVR этой конкретной карты (потолок — см. cardStats.ts).
  // Все карты этого игрока в базе по-прежнему делят Player.overall — буст живёт только на этой карте.
  trainingBoost Int @default(0)

  // Академия молодёжи: BRONZE/SILVER карта растёт на 1 уровень редкости за время + монеты (см. lib/academy.ts)
  academyEnrolledAt DateTime?

  listing Listing?

  @@index([ownerId])
  @@index([playerId])
  @@map("cards")
}

// ──────────────────────────────────────────
// Состав команды
// ──────────────────────────────────────────

model Squad {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  name      String  @default("Состав 1")
  formation String // "4-4-2" | "4-3-3" | "3-5-2" | "4-2-3-1" | "5-3-2"
  /// [{ slotId: string, cardId: string | null }]
  slots     Json
  isActive  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("squads")
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
}

model Listing {
  id       String @id @default(cuid())
  card     Card   @relation(fields: [cardId], references: [id])
  cardId   String @unique
  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  // price — стартовая цена аукциона (минимальная ставка). buyNowPrice — опциональный
  // мгновенный выкуп в обход торгов; если не задан, лот доступен только через ставки.
  price       Int
  buyNowPrice Int?
  status      ListingStatus @default(ACTIVE)

  bids MarketBid[]

  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([status])
  @@map("listings")
}

model MarketBid {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  bidder    User    @relation(fields: [bidderId], references: [id])
  bidderId  String

  amount Int

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("market_bids")
}

// ──────────────────────────────────────────
// Матчи
// ──────────────────────────────────────────

enum MatchMode {
  QUICK
  DIVISION_RIVALS
  TOURNAMENT
  DRAFT
}

model Match {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  mode         MatchMode
  opponentName String
  opponentOvr  Int

  userScore Int @default(0)
  oppScore  Int @default(0)

  events  Json
  rewards Json

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("matches")
}

// ──────────────────────────────────────────
// Экономика
// ──────────────────────────────────────────

enum TransactionType {
  PACK_OPEN
  CASE_SPIN
  QUICK_SELL
  MARKET_BUY
  MARKET_SELL
  MARKET_FEE
  MATCH_REWARD
  DAILY_BONUS
  FREE_BONUS
  EMERGENCY_BONUS
  LUCKY_SPIN
  QUEST_REWARD
  REFERRAL_BONUS
  STARS_PURCHASE
  LEVEL_UP
  SBC_SUBMIT
  ARCADE_PENALTY
  DUEL
  ACADEMY
  STADIUM
  CUP
  WORLD_TOUR
  CLAN
  BATTLE_PASS
  GLOBAL_TOURNAMENT
}

model Transaction {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  type   TransactionType
  amount Int
  meta   Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("transactions")
}

model Quest {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  target      Int
  reward      Int
  isDaily     Boolean @default(true)

  userQuests UserQuest[]

  @@map("quests")
}

model UserQuest {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  quest   Quest  @relation(fields: [questId], references: [id])
  questId String

  progress  Int      @default(0)
  completed Boolean  @default(false)
  claimed   Boolean  @default(false)
  expiresAt DateTime

  @@unique([userId, questId, expiresAt])
  @@map("user_quests")
}

/** Отметка о выполнении одноразового SBC-вызова — определения самих вызовов захардкожены в lib/sbc.ts, как PACKS/CASES. */
model SbcCompletion {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  sbcId       String
  completedAt DateTime @default(now())

  @@unique([userId, sbcId])
  @@index([userId])
  @@map("sbc_completions")
}

// ──────────────────────────────────────────
// PvP «Дуэль» (пенальти против реального состава соперника)
// ──────────────────────────────────────────

enum DuelLeague {
  BRONZE
  SILVER
  GOLD
  CHAMPION
}

/** Одна строка на пользователя — текущая лига и очки кубков. */
model DuelTrophy {
  user   User   @relation(fields: [userId], references: [id])
  userId String @id

  league DuelLeague @default(BRONZE)
  points Int        @default(0)
  wins   Int        @default(0)
  losses Int         @default(0)

  updatedAt DateTime @updatedAt

  @@map("duel_trophies")
}

enum CareerLeague {
  BRONZE
  SILVER
  GOLD
  CHAMPION
}

/** Лига-карьера «Быстрого матча» (Division Rivals) — отдельная от Дуэли система очков/лиг на обычных полных матчах. */
model CareerTrophy {
  user   User   @relation(fields: [userId], references: [id])
  userId String @id

  league CareerLeague @default(BRONZE)
  points Int          @default(0)
  wins   Int          @default(0)
  losses Int          @default(0)

  updatedAt DateTime @updatedAt

  @@map("career_trophies")
}

/** История завершённых дуэлей — для ELO-пересчёта и будущего лидерборда. */
model DuelMatch {
  id String @id @default(cuid())

  attacker   User   @relation("DuelAttacker", fields: [attackerId], references: [id])
  attackerId String

  opponentName String
  opponentOvr  Int
  isRealOpponent Boolean @default(false)

  attackerScore Int
  defenderScore Int
  won           Boolean
  pointsDelta   Int

  // Реакция-эмоция после матча — чисто самовыражение в истории дуэлей (см. lib/duelEmotes.ts).
  // Дуэль асинхронная (снимок состава, не живой канал с соперником), поэтому это не чат, а "поза победителя".
  emote String?

  createdAt DateTime @default(now())

  @@index([attackerId])
  @@map("duel_matches")
}

// ──────────────────────────────────────────
// Кланы
// ──────────────────────────────────────────

model Clan {
  id          String  @id @default(cuid())
  name        String  @unique
  tag         String  @unique
  description String?
  avatarUrl   String?
  leaderId    String

  createdAt DateTime @default(now())

  members ClanMember[]

  @@map("clans")
}

model ClanMember {
  user   User   @relation(fields: [userId], references: [id])
  userId String @id

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  clanId String

  role     String   @default("MEMBER") // "LEADER" | "MEMBER"
  joinedAt DateTime @default(now())

  @@index([clanId])
  @@map("clan_members")
}

// ──────────────────────────────────────────
// Battle Pass
// ──────────────────────────────────────────

/** Отметка о выданной награде конкретного уровня/ветки — не даёт забрать дважды. */
model BattlePassClaim {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  level Int
  track String // "FREE" | "PREMIUM"

  claimedAt DateTime @default(now())

  @@unique([userId, level, track])
  @@index([userId])
  @@map("battle_pass_claims")
}
