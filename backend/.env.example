# Порт, на котором поднимается Express
PORT=4000

# Разрешённый origin для CORS (адрес фронтенда)
CORS_ORIGIN=http://localhost:5273

# PostgreSQL (Neon) — строка подключения с sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (Upstash) — строка подключения
REDIS_URL="rediss://default:password@host:port"

# Секрет для подписи JWT (генерировать случайно, не использовать значение по умолчанию)
JWT_SECRET=change-me-to-a-random-secret

# Токен Telegram-бота — нужен и бэкенду (для проверки initData), и боту
BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cloudflare R2 (хранилище файлов — логотипы команд и т.п.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=football-card-collector
