// Лёгкая схема бота — та же БД, что у backend, но бот трогает
// только оплату: пользователя (баланс/VIP) и транзакции.
// Источник истины по полной схеме — backend/prisma/schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  PACK_OPEN
  CASE_SPIN
  QUICK_SELL
  MARKET_BUY
  MARKET_SELL
  MARKET_FEE
  MATCH_REWARD
  DAILY_BONUS
  QUEST_REWARD
  REFERRAL_BONUS
  STARS_PURCHASE
}

model User {
  id       String  @id @default(cuid())
  tgId     String  @unique
  coins    Int     @default(5000)
  stars    Int     @default(0)
  isVip    Boolean @default(false)
  vipUntil DateTime?

  @@map("users")
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  type   TransactionType
  amount Int
  meta   Json?

  createdAt DateTime @default(now())

  @@map("transactions")
}
